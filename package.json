{
  "name": "ai-usage-status",
  "displayName": "AI Usage Status",
  "description": "Local CodexBar quota windows in the Explorer and the status bar.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "aiUsageStatus.usageView",
          "name": "AI Usage"
        }
      ]
    },
    "commands": [
      {
        "command": "aiUsageStatus.details",
        "title": "AI Usage: Show Details"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run build && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazuno47/ai-usage-status.git"
  }
}
